# Google AI Studio → Get API key. Keep this server-only.
GEMINI_API_KEY=your-gemini-api-key
# Primary chat model; transient 429/5xx errors retry then use the fallback model.
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite
# Gemini embedding model. All existing documents and queries must use the same model.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Vector size configured in supabase/migrations/20261123000000_create_portfolio_documents.sql.
GEMINI_EMBEDDING_DIMENSIONS=768

# Supabase project settings → API → Project URL and service_role key.
# The service role key is server-only. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Generate a random value of at least 32 characters. Used only in Authorization: Bearer for admin APIs.
ADMIN_INGEST_SECRET=generate-a-random-secret-of-at-least-32-characters

# Optional RAG retrieval tuning.
RAG_SIMILARITY_THRESHOLD=0.42
RAG_TOP_K=5
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.5-flash-lite
